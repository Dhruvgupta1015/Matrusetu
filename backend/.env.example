# ==============================================================================
# BHASHINI CREDENTIALS (Government of India - National Language Translation Mission)
# ==============================================================================
# Paste your Bhashini User ID and API Key from the ULCA portal:
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key_here

# Optional: If you were directly given an Inference Key:
BHASHINI_INFERENCE_API_KEY=your_bhashini_inference_api_key_here

# ==============================================================================
# INDICTRANS2 BACKUP (AI4Bharat / IIT Madras)
# Ensures your live demo never fails even if Bhashini is under heavy load
# ==============================================================================
HF_TOKEN=your_huggingface_token_here
